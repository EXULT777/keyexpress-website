# Copy this file to .env for local development. On the hosting, set the same
# names in the Node.js App's environment variables instead (see DEPLOY.md).

# Folder for the database, uploaded images and the session secret. On the server,
# keep it OUTSIDE the code folder, e.g. /home/youruser/keyexpress-data
DATA_DIR=./data

# The Admin login, created the first time the site starts. Changing these later
# does not change an existing password: use Change password in the Admin, or see
# "Forgot the Admin password" in DEPLOY.md.
ADMIN_EMAIL=owner@keyexpress.example
ADMIN_PASSWORD=

# The public address of the site. Used for the sitemap, canonical links and
# social previews.
SITE_URL=http://localhost:3000

# Optional: 32 or more random characters that sign the Admin's login cookie.
# Leave it empty and the site generates one and keeps it in DATA_DIR.
SESSION_SECRET=

# Optional: email new Service Requests. Leave SMTP_HOST empty and requests are
# only saved to the Admin inbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# The sender address, e.g. "Keys Express Website <website@yourdomain.com>"
SMTP_FROM=
