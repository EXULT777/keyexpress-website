diff --git a/src/app/globals.css b/src/app/globals.css
index c825112..dfeaeea 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1,17 +1,42 @@
 @import "tailwindcss";
 
-/* Key Express colors. Every text/background pair used on the site meets WCAG AA
-   (4.5:1); scripts/check-contrast.mjs checks them. Red is only for the
-   24/7 Emergency badge. */
+/* Key Express colors, taken from the logo: black, chrome silver and electric blue.
+   The public website is dark like the logo (the .site-dark wrapper below);
+   the Admin stays light and uses navy, action and the silver tokens.
+   - pitch, carbon, graphite, steel: the logo's black, from the page itself up
+     to cards and their edges (the same steps as the Speedster site).
+   - chrome-1..3: the logo's chrome, for the big headings and the call buttons.
+   - electric: the logo's blue (its letters run from #0488fe to #016af6, main
+     tone #027ef9); sky is a lighter tint of it for small text links on black.
+   Every text/background pair meets WCAG AA; scripts/check-contrast.mjs checks
+   them. Red is only for the 24/7 Emergency badge. */
 @theme {
-  --color-navy: #0b2545;
-  --color-action: #1e56c7;
-  --color-action-hover: #16439e;
-  --color-silver: #c5ccd6;
-  --color-silver-soft: #e9edf2;
-  --color-silver-light: #f3f5f8;
-  --color-ink: #1a202c;
-  --color-ink-soft: #3b4556;
+  --color-pitch: #0a0a0b;
+  --color-carbon: #141416;
+  --color-graphite: #1e1f23;
+  --color-steel: #2c2e33;
+  --color-steel-line: #767c86;
+  --color-chrome-1: #f5f5f6;
+  --color-chrome-2: #cfd0d3;
+  --color-chrome-3: #8f9399;
+  --color-body: #e8e9eb;
+  --color-muted: #a6abb3;
+  --color-electric: #027ef9;
+  --color-electric-deep: #016af6;
+  --color-sky: #3d9bff;
+  --color-success-glow: #5fd38a;
+  --color-error-glow: #ff7a7a;
+
+  --color-navy: #0a0a0b;
+  --color-navy-deep: #050506;
+  --color-navy-raised: #1e1f23;
+  --color-action: #016af6;
+  --color-action-hover: #0157cc;
+  --color-silver: #d5dde8;
+  --color-silver-soft: #e6ecf4;
+  --color-silver-light: #f7f9fc;
+  --color-ink: #0e1726;
+  --color-ink-soft: #45526a;
   --color-emergency: #c62828;
   --color-success: #1e6b3a;
   --color-error: #b3261e;
@@ -64,6 +89,22 @@
     outline-color: var(--color-action);
   }
 
+  /* The public website: dark like the logo. */
+  body:has(.site-dark) {
+    background: var(--color-pitch);
+    color-scheme: dark;
+  }
+
+  .site-dark {
+    color: var(--color-body);
+    color-scheme: dark;
+  }
+
+  .site-dark ::selection {
+    background: var(--color-electric-deep);
+    color: #ffffff;
+  }
+
   summary {
     cursor: pointer;
     list-style: none;
@@ -74,14 +115,6 @@
   }
 }
 
-@layer components {
-  /* The bottom of the brushed-silver gradient is too dark for #1e56c7 text
-     (4.0:1), so links there use the darker blue (5.6:1). */
-  .bg-brushed .text-action {
-    color: var(--color-action-hover);
-  }
-}
-
 /* Admin-written Markdown (the Privacy Policy and its preview). */
 @layer components {
   .policy > * + * {
@@ -130,10 +163,114 @@
     border-left: 4px solid var(--color-silver);
     padding-left: 1rem;
   }
+
+  /* The policy on the dark public website (the Admin preview stays light). */
+  .site-dark .policy a {
+    color: var(--color-sky);
+  }
+
+  .site-dark .policy a:hover {
+    color: #ffffff;
+  }
+
+  .site-dark .policy blockquote {
+    border-left-color: var(--color-steel-line);
+  }
+}
+
+/* Button motion, as on the Speedster site: a light sweeps across on hover or
+   keyboard focus, the button presses in when tapped, and call buttons can send
+   out a soft pulsing ring. The reduced-motion rule at the end of this file turns
+   all of it off. */
+@layer components {
+  .btn-motion {
+    position: relative;
+    isolation: isolate;
+    overflow: hidden;
+    transition:
+      background-color 0.2s,
+      color 0.2s,
+      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
+  }
+
+  .btn-motion::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background: linear-gradient(105deg, transparent 30%, var(--shine, rgb(255 255 255 / 0.38)) 48%, transparent 66%);
+    transform: translateX(-130%);
+    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
+    pointer-events: none;
+  }
+
+  .btn-motion:hover::after,
+  .btn-motion:focus-visible::after {
+    transform: translateX(130%);
+  }
+
+  .btn-motion:active {
+    transform: translateY(1px) scale(0.97);
+  }
+
+  .btn-pulse {
+    animation: call-pulse 2.6s ease-out infinite;
+  }
+}
+
+@keyframes call-pulse {
+  0% {
+    box-shadow: 0 0 0 0 var(--pulse, rgb(2 126 249 / 0.5));
+  }
+  70%,
+  100% {
+    /* Fade out in the ring's own color, so it doesn't turn grey on midnight. */
+    box-shadow: 0 0 0 14px var(--pulse-end, rgb(2 126 249 / 0));
+  }
+}
+
+/* Chrome lettering, like the logo's "KEYS": for big headings only, never body
+   text. Its darkest stop (#8f9399) still reads 6.4:1 on pitch. */
+@utility text-chrome {
+  background-image: linear-gradient(
+    180deg,
+    var(--color-chrome-1) 0%,
+    #ffffff 30%,
+    var(--color-chrome-2) 55%,
+    var(--color-chrome-3) 62%,
+    var(--color-chrome-1) 100%
+  );
+  /* One sweep per line (headings use line-height 1.2), so every line shines. */
+  background-size: 100% 1.2em;
+  background-repeat: repeat-y;
+  -webkit-background-clip: text;
+  background-clip: text;
+  color: transparent;
+
+  /* High-contrast mode drops the gradient; give the text its color back. */
+  @media (forced-colors: active) {
+    background-image: none;
+    color: CanvasText;
+  }
+}
+
+/* The logo's black with a soft electric-blue glow and a faint dot grid, for the
+   top of each page and the feature bands. */
+@utility bg-night {
+  background-color: var(--color-pitch);
+  background-image:
+    radial-gradient(56rem 28rem at 88% 8%, rgb(2 126 249 / 0.3), transparent 62%),
+    radial-gradient(40rem 22rem at 0% 110%, rgb(2 126 249 / 0.14), transparent 60%),
+    radial-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1.5px);
+  background-size:
+    auto,
+    auto,
+    22px 22px;
 }
 
-@utility bg-brushed {
-  background-image: linear-gradient(180deg, #e9edf2 0%, #c5ccd6 100%);
+/* The thin line along the top of cards: the logo lettering's own blue gradient. */
+@utility bg-electric {
+  background-image: linear-gradient(90deg, #016af6 0%, #0488fe 100%);
 }
 
 @media (prefers-reduced-motion: no-preference) {
